# Copy to .env.local and fill in. Never commit real values.
# On Vercel set the same names under Project Settings > Environment Variables (Production).

# This site's public origin (no trailing slash). Local: http://localhost:3000. Production: https://<your-frontend-domain>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Carrivo API base URL including /api/v1 (server only; never exposed to the browser)
API_BASE_URL=https://carrivo-backend.vercel.app/api/v1

# Signs the role cookie the proxy trusts (server only, 32+ random chars, e.g. `openssl rand -base64 48`)
SESSION_SECRET=

# Shared secret sent as x-bff-secret with x-client-ip so the API rate-limits per real visitor (server only).
# Must equal the backend's BFF_SHARED_SECRET (sent as x-bff-secret with x-client-ip, so the API rate-limits per visitor).
BFF_SHARED_SECRET=

# Password of the seeded demo accounts (server only, used by /api/auth/demo; never NEXT_PUBLIC_)
DEMO_PASSWORD=

# Seeded demo accounts for the one-click demo (emails only). There is deliberately no admin entry:
# the demo "Admin (view-only)" is the read-only viewer; the real admin signs in with the form.
NEXT_PUBLIC_DEMO_VIEWER_EMAIL=viewer@carrivo.dev
NEXT_PUBLIC_DEMO_COURIER_EMAIL=courier1@carrivo.dev
NEXT_PUBLIC_DEMO_CUSTOMER_EMAIL=customer1@carrivo.dev

# Public support address used by /contact (optional; defaults to support@carrivo.dev)
NEXT_PUBLIC_CONTACT_EMAIL=

# Business time zone for dates, filters and pickup windows (optional; must match the API's zone).
# NEXT_PUBLIC_BUSINESS_TIME_ZONE=America/New_York
