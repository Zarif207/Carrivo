# Copy to .env.local and fill in. Never commit real values.

# This site's public origin (no trailing slash), e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Carrivo API base URL including /api/v1 (server only; never exposed to the browser)
API_BASE_URL=https://carrivo-backend.vercel.app/api/v1

# Signs the role cookie the proxy trusts (server only, 32+ random chars, e.g. `openssl rand -base64 48`)
SESSION_SECRET=

# Shared secret sent as x-bff-secret with x-client-ip so the API rate-limits per real visitor (server only)
BFF_SHARED_SECRET=

# Password of the seeded demo accounts (server only, used by /api/auth/demo)
DEMO_PASSWORD=

# Seeded demo accounts (emails only)
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@carrivo.dev
NEXT_PUBLIC_DEMO_COURIER_EMAIL=courier1@carrivo.dev
NEXT_PUBLIC_DEMO_CUSTOMER_EMAIL=customer1@carrivo.dev

# Public support address used by /contact (optional; defaults to support@carrivo.dev)
NEXT_PUBLIC_CONTACT_EMAIL=
